{
  "schemaVersion": 1,
  "subject": {
    "conventional": true,
    "maxLength": 50,
    "types": [
      "build",
      "chore",
      "ci",
      "docs",
      "feat",
      "fix",
      "perf",
      "refactor",
      "revert",
      "style",
      "test",
      "cleanup"
    ],
    "lowercaseInitial": true,
    "rejectTerminalPeriod": true
  },
  "branch": {
    "types": null,
    "exempt": [
      "main",
      "staging"
    ],
    "maxLength": 50
  },
  "commits": {
    "signatures": "present",
    "rejectCoauthors": true,
    "rejectClaudeAttribution": true
  },
  "hooks": {
    "files": [
      {
        "source": "scripts/git/hooks/commit-msg",
        "target": "commit-msg",
        "executable": true
      },
      {
        "source": "scripts/git/hooks/pre-push",
        "target": "pre-push",
        "executable": true
      }
    ]
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "CI gate",
        "workflow": "CI"
      }
    ],
    "requireStrictBaseFreshness": true
  },
  "versions": {
    "packages": [
      "packages/frontend",
      "packages/backend-v2"
    ],
    "lockfile": null
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "images": {
    "targets": {
      "favicons": {
        "outputs": [
          { "path": "favicon.svg", "layers": [{ "source": "logo" }] },
          { "path": "favicon.ico", "sizes": [16, 32, 48], "layers": [{ "source": "logo" }] },
          {
            "path": "apple-touch-icon.png",
            "size": 180,
            "opaque": true,
            "layers": [{ "fill": "#ffffff" }, { "source": "logo", "scale": 0.8 }]
          }
        ]
      },
      "pwa-icons": {
        "dir": "packages/frontend/public",
        "outputs": [
          { "path": "pwa-192x192.png", "size": 192, "layers": [{ "source": "logo" }] },
          { "path": "pwa-512x512.png", "size": 512, "layers": [{ "source": "logo" }] }
        ]
      },
      "social": {
        "dir": "packages/website/public",
        "outputs": [
          {
            "path": "og-image.png",
            "size": [1200, 630],
            "opaque": true,
            "layers": [{ "fill": "#ffffff" }, { "source": "logo", "scale": 0.5 }]
          }
        ]
      }
    }
  }
}

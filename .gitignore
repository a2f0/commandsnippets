# Terraform
# https://github.com/github/gitignore/blob/master/Terraform.gitignore
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.backend
*.tfvars

# BlackBox
/.blackbox/pubring.gpg~
/.blackbox/pubring.kbx~
/.blackbox/secring.gpg
/dns/main.tfvars
/container-registry/main.tfvars
/container-registry/terraform.backend
/staging/main.tfvars
/staging/terraform.backend
/dns/terraform.backend
/ansible/inventory.yaml
/ssh_keys/tearleads-backend-deploy-key
/ssh_keys/tearleads-frontend-deploy-key
/production/main.tfvars
/production/terraform.backend
/production-s3/main.tfvars
/production-s3/terraform.backend
/vercel/terraform.backend
/vercel/main.tfvars

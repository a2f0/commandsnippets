{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "lib": ["esnext", "dom", "dom.iterable"],
  "compilerOptions": {
    "target": "esnext",
    "rootDir": ".",
    "outDir": "build",
    "jsx": "react",
    // Don't check node_modules
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "src/Empty.ts"]
}

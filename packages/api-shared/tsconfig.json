{
  // Self-contained: consumers' bundlers read this file for api-shared's
  // sources (see README), where an `extends` package may not be installed.
  // The first group is @tsconfig/strictest's options, which the web app
  // compiles with (test/tsconfig.test.ts keeps them in step).
  "compilerOptions": {
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": [],
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src"]
}

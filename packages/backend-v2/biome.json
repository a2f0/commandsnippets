{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.wrangler",
      "!**/coverage",
      "!worker-configuration.d.ts",
      "!migrations/meta"
    ]
  },
  "overrides": [
    {
      "includes": ["src/index.ts", "*.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}

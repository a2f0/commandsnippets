{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commandsnippets-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // api-shared is installed as symlinks to ../api-shared, so the bundler
  // resolves its imports from there: bundle this package's (only) zod.
  // Wrangler matches each alias exactly, so every entry api-shared imports
  // needs its own (it uses zod/mini; `zod` is for any future import of it).
  "alias": {
    "zod": "./node_modules/zod/index.js",
    "zod/mini": "./node_modules/zod/mini/index.js"
  },
  // Local development. Mirrors Django's DEBUG=True cookie behavior.
  "vars": {
    "DEBUG": "true",
    "COOKIE_NAME_PREFIX": "",
    "COOKIE_DOMAIN": "localhost",
    "GITHUB_REDIRECT_URI": "http://localhost:8085/oauth/github",
    "GOOGLE_REDIRECT_URI": "http://localhost:8085/oauth/google"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "commandsnippets-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "staging": {
      // Custom domain (Terraform manages the zone, wrangler the Worker's hosts).
      "workers_dev": false,
      "routes": [
        { "pattern": "api-staging.commandsnippets.com", "custom_domain": true }
      ],
      // Staging's hosts are app-staging / api-staging, so its cookies share
      // .commandsnippets.com with production's and are told apart by name.
      "vars": {
        "DEBUG": "false",
        "COOKIE_DOMAIN": ".commandsnippets.com",
        // Distinct names: both environments' cookies reach both hosts.
        "COOKIE_NAME_PREFIX": "Staging",
        "GITHUB_REDIRECT_URI": "https://app-staging.commandsnippets.com/oauth/github",
        "GOOGLE_REDIRECT_URI": "https://app-staging.commandsnippets.com/oauth/google"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "commandsnippets-staging",
          "database_id": "fa0a2b48-82ac-42c8-af40-00e3d834d0ac",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      // Custom domain (Terraform manages the zone, wrangler the Worker's hosts).
      "workers_dev": false,
      "routes": [
        { "pattern": "api.commandsnippets.com", "custom_domain": true }
      ],
      "vars": {
        "DEBUG": "false",
        "COOKIE_DOMAIN": ".commandsnippets.com",
        "COOKIE_NAME_PREFIX": "",
        "GITHUB_REDIRECT_URI": "https://app.commandsnippets.com/oauth/github",
        "GOOGLE_REDIRECT_URI": "https://app.commandsnippets.com/oauth/google"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "commandsnippets-production",
          "database_id": "12e98511-6a2c-4d78-9bed-42990cc76072",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}

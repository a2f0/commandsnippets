{
  "name": "commandsnippets-backend-v2",
  "version": "0.2.28",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "bun@1.4.3",
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "wrangler dev --port 9001",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scripts": "bun test --coverage ./scripts/",
    "manage": "bun scripts/admin/manage.ts"
  },
  "dependencies": {
    "@commandsnippets/api-shared": "file:../api-shared",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}

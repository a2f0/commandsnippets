---
import Base from '../layouts/Base.astro';
import {appUrl} from '../lib/appUrl';
import {indexable, pageUrl, SITE_DESCRIPTION, SITE_NAME} from '../lib/site';

const mode = import.meta.env.MODE;
const app = appUrl(mode);
const home = pageUrl(mode, '/');
const organization = `${home}#organization`;
// Structured data for search engines, in production only; only facts this
// site states.
const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organization,
      name: SITE_NAME,
      url: home,
    },
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: SITE_NAME,
      url: home,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: {'@id': organization},
    },
    {
      '@type': 'WebApplication',
      '@id': `${home}#app`,
      name: SITE_NAME,
      url: new URL('/', app).href,
      description: SITE_DESCRIPTION,
      applicationCategory: 'DeveloperApplication',
      // The web app only, until the native apps are published.
      operatingSystem: 'Web',
      publisher: {'@id': organization},
    },
  ],
}).replaceAll('<', '\\u003c');
---

<Base
  title="Note-Taking for Technical Professionals · Commandsnippets"
  description="Solve, curate, retrieve. Commandsnippets is an opinionated note-taking system for technical professionals, built around tagged command snippets."
>
  <Fragment slot="head">
    {
      indexable(mode) && (
        <script type="application/ld+json" set:html={structuredData} />
      )
    }
  </Fragment>
  <section class="hero">
    <h1>Solve, Curate, Retrieve.</h1>
    <p id="tagLine">
      An opinionated note-taking system for technical professionals.
    </p>
    <a class="login" href={app}>Get started</a>
  </section>
</Base>

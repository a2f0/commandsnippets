---
import '../styles/global.css';
import {appUrl, FOOTER_LINKS} from '../lib/appUrl';
import {
  NOINDEX,
  PREVIEW_IMAGE,
  pageUrl,
  SITE_DESCRIPTION,
  SITE_NAME,
  searchable,
} from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /**
   * The page has no content yet (`Placeholder.astro`), so it stays out of
   * search on every tier until it does (`searchable` in `../lib/site`).
   */
  placeholder?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  placeholder = false,
} = Astro.props;
const mode = import.meta.env.MODE;
const app = appUrl(mode);
const mayIndex = searchable(mode, placeholder);
// Built pages are directories (`/privacy/`), the form the assets are served at.
// Pages that may not be indexed name no URL for search engines to follow.
const canonical = mayIndex ? pageUrl(mode, Astro.url.pathname) : undefined;
// Link previews need an absolute image URL; each build names its own host's.
const previewImage = pageUrl(mode, PREVIEW_IMAGE.path);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!mayIndex && <meta name="robots" content={NOINDEX} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      name="theme-color"
      content="#f5f5f5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1e1e1e"
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:width" content={String(PREVIEW_IMAGE.width)} />
    <meta property="og:image:height" content={String(PREVIEW_IMAGE.height)} />
    <meta property="og:image:alt" content={PREVIEW_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <header>
      <a class="brand" href="/">Commandsnippets</a>
      <a class="login" id="loginLink" href={app}>App</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <nav aria-label="Site">
        {FOOTER_LINKS.map(link => <a href={link.href}>{link.text}</a>)}
      </nav>
      <div class="muted">© {year} Commandsnippets. All rights reserved.</div>
    </footer>
    <script>
      import {initClickTracking} from '../lib/clickTracking';
      initClickTracking();
    </script>
  </body>
</html>

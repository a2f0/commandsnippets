{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "off",
        "useUniqueElementIds": "off"
      },
      "a11y": {
        "useValidAriaRole": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@mui/icons-material": "Import each icon from its own path ('@mui/icons-material/Check'): the package index loads every icon in dev and tests."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/*.tsx",
        "src/components/**",
        "src/hooks/**",
        "src/menu/**",
        "src/pages/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@mui/icons-material": "Import each icon from its own path ('@mui/icons-material/Check'): the package index loads every icon in dev and tests."
                },
                "patterns": [
                  {
                    "group": ["**/lib/db", "**/lib/db/**"],
                    "message": "The UI reaches IndexedDB only through lib/data (its hooks, writes and helpers such as keyOfRow), never the Dexie database module."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@mui/icons-material": "Import each icon from its own path ('@mui/icons-material/Check'): the package index loads every icon in dev and tests."
                },
                "patterns": [
                  {
                    "group": [
                      "**/components",
                      "**/components/**",
                      "**/pages",
                      "**/pages/**",
                      "**/menu",
                      "**/menu/**",
                      "**/hooks/**"
                    ],
                    "message": "src/lib sits below the UI: it never imports components, pages, menu or hooks. Move the shared code into lib, or pass it in."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["__tests__/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/coverage",
      "!**/.ts-out",
      "!**/build",
      "!**/dev-dist",
      "!**/dist",
      "!public/mockServiceWorker.js"
    ]
  }
}

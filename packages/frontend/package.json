{
  "name": "commandsnippets-frontend",
  "version": "0.7.120",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/commandsnippets.git",
    "directory": "packages/frontend"
  },
  "type": "module",
  "engines": {
    "node": "=24.21.0"
  },
  "scripts": {
    "server-test": "vite serve --mode test --port 8081",
    "dev": "vite serve --host",
    "test": "wdio test/wdio.shared.conf.ts",
    "test-headless": "wdio test/wdio.headless.conf.ts",
    "ci": "start-server-and-test 'bun run server-test' http-get://localhost:8081 'bun run test'",
    "ci-headless": "start-server-and-test 'bun run server-test' http-get://localhost:8081 'bun run test-headless'",
    "unit": "vitest --no-watch",
    "fix": "biome check --write",
    "format": "biome format",
    "lint": "biome lint",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "analyze": "bun run build:analyze",
    "clean": "rimraf build",
    "compile": "tsc -b --force",
    "prepare": "bun run compile",
    "deploy:staging": "bun run build:staging && wrangler deploy --env staging",
    "deploy:production": "bun run build:production && wrangler deploy --env production"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@tsconfig/strictest": "2.0.8",
    "@types/invariant": "2.2.37",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-highlight-words": "0.20.1",
    "@vitejs/plugin-react": "6.1.1",
    "@wdio/cli": "9.32.0",
    "@wdio/dot-reporter": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/reporter": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "fake-indexeddb": "6.2.5",
    "history": "5.3.0",
    "invariant": "2.2.4",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "rimraf": "6.1.3",
    "start-server-and-test": "3.0.12",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-bundle-analyzer": "1.3.9",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2",
    "wdio-video-reporter": "6.2.0",
    "webdriverio": "9.32.0",
    "wrangler": "4.141.0"
  },
  "dependencies": {
    "@commandsnippets/api-shared": "file:../api-shared",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@tanstack/react-virtual": "3.14.13",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "react": "19.3.0",
    "react-cookie": "8.1.2",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.3.0",
    "react-highlight-words": "0.21.0",
    "react-i18next": "17.0.15",
    "uuid": "14.0.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.3",
    "serialize-javascript": "7.1.2"
  },
  "trustedDependencies": [
    "@ffmpeg-installer/darwin-arm64",
    "@ffmpeg-installer/darwin-x64",
    "@ffmpeg-installer/linux-arm",
    "@ffmpeg-installer/linux-arm64",
    "@ffmpeg-installer/linux-ia32",
    "@ffmpeg-installer/linux-x64",
    "@ffmpeg-installer/win32-ia32",
    "@ffmpeg-installer/win32-x64",
    "edgedriver",
    "esbuild",
    "geckodriver",
    "workerd"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

{
  "name": "commandsnippets-frontend",
  "version": "0.7.180",
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/commandsnippets.git",
    "directory": "packages/frontend"
  },
  "type": "module",
  "engines": {
    "node": "=24.22.1"
  },
  "scripts": {
    "images": "../../node_modules/.bin/agent-tool --repo ../.. images build favicons --out packages/frontend/public && ../../node_modules/.bin/agent-tool --repo ../.. images build pwa-icons",
    "server-test": "bun run images && vite serve --mode test --port 8081",
    "dev": "bun run images && vite serve --host",
    "test": "wdio test/wdio.shared.conf.ts",
    "test-headless": "wdio test/wdio.headless.conf.ts",
    "ci": "start-server-and-test 'bun run server-test' http-get://localhost:8081 'bun run test'",
    "ci-headless": "start-server-and-test 'bun run server-test' http-get://localhost:8081 'bun run test-headless'",
    "unit": "../../scripts/testing/runUnitTests.sh",
    "fix": "biome check --write",
    "format": "biome format",
    "lint": "biome lint",
    "build": "bun run images && vite build",
    "build:analyze": "bun run images && vite build --mode analyze",
    "build:staging": "bun run images && vite build --mode staging",
    "build:production": "bun run images && vite build --mode production",
    "analyze": "bun run build:analyze",
    "clean": "rimraf build",
    "compile": "tsc -b --force",
    "prepare": "bun run compile",
    "deploy:staging": "bun run build:staging && wrangler deploy --env staging",
    "deploy:production": "bun run build:production && wrangler deploy --env production",
    "test:spec": "./scripts/testing/runSpec.sh",
    "test:spec:headless": "./scripts/testing/runSpecHeadless.sh"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@tsconfig/strictest": "2.0.8",
    "@types/invariant": "2.2.37",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wdio/cli": "9.32.0",
    "@wdio/dot-reporter": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/reporter": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/types": "9.32.0",
    "fake-indexeddb": "6.2.6",
    "history": "5.3.0",
    "invariant": "2.2.4",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "rimraf": "6.1.3",
    "start-server-and-test": "3.0.13",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-bundle-analyzer": "1.3.9",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "wdio-video-reporter": "6.2.0",
    "webdriverio": "9.32.0",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@a2f0/ct-client": "0.1.5",
    "@commandsnippets/api-shared": "workspace:*",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-virtual": "3.14.21",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "i18next": "26.5.3",
    "i18next-browser-languagedetector": "8.2.1",
    "react": "19.3.1",
    "react-cookie": "8.1.2",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.3.1",
    "react-highlight-words": "1.0.0",
    "react-i18next": "17.1.0",
    "uuid": "14.0.3",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}

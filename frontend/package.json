{
  "name": "tearleads-frontend",
  "version": "0.7.101",
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a2f0/commandsnippets.git",
    "directory": "frontend"
  },
  "main": "out/main/main.js",
  "type": "module",
  "engines": {
    "node": "=24.19.0"
  },
  "scripts": {
    "server": "vite serve --host",
    "server-test": "vite serve --mode test --port 8081",
    "dev": "vite serve --host",
    "test": "npx wdio test/wdio.shared.conf.ts",
    "test-headless": "npx wdio test/wdio.headless.conf.ts",
    "ci": "start-server-and-test server-test http-get://localhost:8081 test",
    "ci-headless": "start-server-and-test server-test http-get://localhost:8081 test-headless",
    "unit": "npx vitest --no-watch",
    "fix": "biome check --write",
    "format": "biome format",
    "lint": "biome lint",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "analyze": "pnpm run build:analyze",
    "clean": "rimraf build",
    "compile": "tsc -b",
    "prepare": "npm run compile",
    "cap:sync": "cap sync",
    "cap:sync:staging": "cp capacitor.config.staging.ts capacitor.config.ts && cap sync",
    "cap:sync:production": "cp capacitor.config.production.ts capacitor.config.ts && cap sync",
    "cap:build:staging": "pnpm run build:staging && pnpm run cap:sync:staging",
    "cap:build:production": "pnpm run build:production && pnpm run cap:sync:production",
    "appium:ios": "npx wdio test/wdio.appium.ios.conf.ts",
    "appium:android": "npx wdio test/wdio.appium.android.conf.ts",
    "appium:build-and-test": "./scripts/setup-appium-ios.sh",
    "appium:android:build-and-test": "scripts/setup-appium-android.sh && cap sync && (cd android && ./gradlew assembleDebug) && pnpm run appium:android",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:build:staging": "electron-vite build --mode staging",
    "electron:build:production": "electron-vite build --mode production",
    "electron:start": "electron-vite preview",
    "electron:generate-icon": "scripts/generate-icon.sh",
    "electron:pre-build": "pnpm run electron:generate-icon && pnpm run electron:build",
    "electron:pre-build:staging": "pnpm run electron:generate-icon && pnpm run electron:build:staging",
    "electron:pre-build:production": "pnpm run electron:generate-icon && pnpm run electron:build:production",
    "electron:pack": "pnpm run electron:pre-build && electron-builder",
    "electron:pack:staging": "pnpm run electron:pre-build:staging && electron-builder",
    "electron:pack:production": "pnpm run electron:pre-build:production && electron-builder",
    "electron:dist": "pnpm run electron:pre-build && electron-builder --publish=never",
    "electron:dist:staging": "pnpm run electron:pre-build:staging && electron-builder --publish=never",
    "electron:dist:production": "pnpm run electron:pre-build:production && electron-builder --publish=never",
    "electron:test": "npx wdio test/wdio.electron.conf.ts",
    "electron:build-and-test": "pnpm run electron:pack && pnpm run electron:test"
  },
  "keywords": [],
  "author": "Dan Sullivan",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@capacitor/cli": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.23",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/invariant": "2.2.37",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-highlight-words": "0.20.1",
    "@vitejs/plugin-react": "5.2.0",
    "@wdio/appium-service": "9.30.1",
    "@wdio/cli": "9.30.1",
    "@wdio/dot-reporter": "9.30.1",
    "@wdio/electron-service": "10.2.0",
    "@wdio/globals": "9.29.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/reporter": "9.30.1",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/types": "9.30.1",
    "appium": "3.6.0",
    "appium-uiautomator2-driver": "8.4.0",
    "appium-xcuitest-driver": "12.3.3",
    "concurrently": "10.0.4",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fake-indexeddb": "6.2.5",
    "history": "5.3.0",
    "invariant": "2.2.4",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "rimraf": "6.1.3",
    "start-server-and-test": "3.0.12",
    "stream-browserify": "3.0.0",
    "swc-loader": "0.2.7",
    "tree-kill": "1.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "url-loader": "4.1.1",
    "vite": "7.3.6",
    "vite-bundle-analyzer": "1.3.9",
    "vite-plugin-html": "3.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "wdio-video-reporter": "6.2.0",
    "webdriverio": "9.30.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/ios": "8.5.0",
    "@capacitor/status-bar": "8.0.3",
    "@capgo/capacitor-social-login": "8.4.2",
    "@emotion/css": "11.13.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@libsql/client": "0.17.4",
    "@mui/icons-material": "9.3.1",
    "@mui/material": "9.3.1",
    "dexie": "4.4.4",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "immutability-helper": "3.1.1",
    "mobx": "6.16.1",
    "mobx-react": "9.2.2",
    "mobx-state-tree": "7.3.2",
    "process": "0.11.10",
    "react": "19.2.8",
    "react-cookie": "8.1.2",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-highlight-words": "0.21.0",
    "react-i18next": "17.0.11",
    "react-router-dom": "7.18.2",
    "uuid": "14.0.1"
  },
  "packageManager": "pnpm@11.21.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "build": {
    "appId": "com.tearleads.app",
    "productName": "Tearleads",
    "directories": {
      "output": "dist-electron"
    },
    "icon": "build/icon.png",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}

#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
MESSAGE_FILE="$1"

cd "$REPO_ROOT"

# Check the unchanged message before commitlint applies the full project rules.
"$REPO_ROOT/node_modules/.bin/agent-tool" commits check --message-file "$MESSAGE_FILE"

echo "Linting commit message..."
COMMITLINT="$REPO_ROOT/node_modules/.bin/commitlint"
"$COMMITLINT" --config "$REPO_ROOT/commitlint.config.mts" --edit "$MESSAGE_FILE"

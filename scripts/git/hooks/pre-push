#!/bin/sh

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# A copied hook must match the checked-out version before it can gate a push.
if ! cmp -s "$0" "$REPO_ROOT/scripts/git/hooks/pre-push"; then
  echo "Error: pre-push hook is stale. Run bun run hooks:install." >&2
  exit 1
fi

# shellcheck disable=SC1091
. "$REPO_ROOT/scripts/lib/stepTimings.sh"

cd "$REPO_ROOT"

push_remote=${1:-}
zero_sha="0000000000000000000000000000000000000000"

refs_file=$(mktemp)
scopes_file=$(mktemp)
timings_log=$("$REPO_ROOT/scripts/git/showPushGateTimings.sh" --log-path 2>/dev/null) ||
  timings_log=""

# Every run is persisted so `showPushGateTimings.sh` (and the ship-pr report)
# can read it back afterwards; a run that dies mid-check records where.
record_timings() {
  [ -n "$timings_log" ] || return 0
  if [ "$1" -eq 0 ]; then
    timings_status=passed
  else
    timings_status=failed
  fi
  # One head= field per commit pushed; a deletion falls back to HEAD.
  timings_heads=$(awk -v zero="$zero_sha" '$2 != zero { print "head=" $2 }' "$refs_file")
  [ -n "$timings_heads" ] || timings_heads="head=$(git rev-parse HEAD)"
  # Deliberately unquoted: each line is one head= field of hex SHAs.
  # shellcheck disable=SC2086
  step_timings_append_log "$timings_log" \
    "status=$timings_status" \
    "branch=$(git rev-parse --abbrev-ref HEAD)" \
    $timings_heads \
    "remote=${push_remote:-unknown}"
}

on_exit() {
  push_status=$?
  record_timings "$push_status" || true
  rm -f "$refs_file" "$scopes_file"
}

trap on_exit EXIT
trap 'exit 1' HUP INT TERM

if [ -t 0 ]; then
  : >"$refs_file"
else
  cat >"$refs_file"
fi

# The commits a pushed ref adds: everything since the remote's old tip, or
# since main for a new branch.
push_range() {
  if [ "$2" = "$zero_sha" ]; then
    printf 'main..%s\n' "$1"
  else
    printf '%s..%s\n' "$2" "$1"
  fi
}

# The scopes the pushed commits need, classified as CI classifies them, as
# `<scope>=<bool>` lines. The classifier runs as committed
# (scripts/checks/ciChanges.ts and ciPolicy.ts), never the worktree's copy:
# an uncommitted edit to the policy must not decide which checks vouch for
# the push. It runs only after the pushed commits passed the trust checks.
classify_push() {
  classifier_dir=$(mktemp -d)
  for file in ciChanges.ts ciPolicy.ts; do
    if ! git show "$1:scripts/checks/$file" >"$classifier_dir/$file"; then
      rm -rf "$classifier_dir"
      return 1
    fi
  done
  classify_status=0
  bun "$classifier_dir/ciChanges.ts" --range "$2" || classify_status=$?
  rm -rf "$classifier_dir"
  return "$classify_status"
}

needs() {
  grep -qx "$1=true" "$scopes_file"
}

# The area checks run against the worktree, so they only vouch for the push
# when the worktree *is* the pushed commit: every pushed ref must be HEAD, no
# tracked file may differ from it, and no untracked file may sit under the
# checked paths (it would be tested without being pushed).
require_pushed_refs_are_head() {
  head_sha=$(git rev-parse HEAD)
  while read -r _ local_sha _ _; do
    [ "$local_sha" != "$zero_sha" ] || continue
    if [ "$local_sha" != "$head_sha" ]; then
      echo "Error: pre-push validates the checked-out commit, but this push sends $local_sha." >&2
      echo "Check out the branch being pushed and push again." >&2
      exit 1
    fi
  done <"$refs_file"
}

require_worktree_is_push() {
  require_pushed_refs_are_head
  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "Error: uncommitted changes would be validated instead of the pushed commit:" >&2
    git status --short --untracked-files=no >&2
    exit 1
  fi
  untracked=$(git status --porcelain --untracked-files=all -- "$@")
  if [ -n "$untracked" ]; then
    echo "Error: untracked files would be validated with the pushed commit:" >&2
    printf '%s\n' "$untracked" >&2
    exit 1
  fi
}

step_timings_reset

step_timings_run branch-name "$REPO_ROOT/node_modules/.bin/agent-tool" branch check --pre-push <"$refs_file"

step_timings_begin commit-trust "Checking commit signatures and co-authors"
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" != "$zero_sha" ] || continue
  set -- "$REPO_ROOT/node_modules/.bin/agent-tool" commits check --range "$(push_range "$local_sha" "$remote_sha")"
  # Integrating the fetched base must not re-check commits the destination
  # already owns. Keep the original range when pushing directly to a URL/path.
  if git remote get-url "$push_remote" >/dev/null 2>&1; then
    set -- "$@" --exclude-remotes "$push_remote"
  fi
  "$@" </dev/null
done <"$refs_file"
step_timings_end

# Only the checked-out commit is vouched for, so only it is classified: its
# committed code is what runs next. A push of only deletions needs nothing.
require_pushed_refs_are_head
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" != "$zero_sha" ] || continue
  classify_push "$local_sha" "$(push_range "$local_sha" "$remote_sha" | sed 's/\.\./.../')" >>"$scopes_file"
done <"$refs_file"

# Each scope runs its CI lane's checks, except the frontend's, which take too
# long for a push and are left to CI.
if needs tooling; then
  require_worktree_is_push scripts packages/frontend/scripts terraform/scripts .agents .claude \
    .codex agent-tool.json .agent-tool-skills.json .agent-tool-permissions.json \
    commitlint.config.mts package.json bunfig.toml bun.lock
  step_timings_run tooling-shell bun run lint:shell
  step_timings_run tooling-typecheck bun run typecheck
  step_timings_run tooling-tests sh -c 'bun run test:agent-tool && bun run test:scripts'
fi

# Installing from a workspace package installs every package from the root
# bun.lock, so this one install serves the package checks after it.
if needs apiShared && [ -d "$REPO_ROOT/packages/api-shared" ]; then
  require_worktree_is_push packages/api-shared
  step_timings_run api-shared-install sh -c 'cd packages/api-shared && bun install --frozen-lockfile'
  step_timings_run api-shared-lint sh -c 'cd packages/api-shared && bun run lint'
  step_timings_run api-shared-typecheck sh -c 'cd packages/api-shared && bun run typecheck'
  step_timings_run api-shared-tests sh -c 'cd packages/api-shared && bun run test'
fi

# backend-v2's workspace link to api-shared shows every api-shared change
# without a reinstall.
if needs backendV2 && [ -d "$REPO_ROOT/packages/backend-v2" ]; then
  require_worktree_is_push packages/backend-v2
  step_timings_run backend-v2-lint sh -c 'cd packages/backend-v2 && bun run lint'
  step_timings_run backend-v2-typecheck sh -c 'cd packages/backend-v2 && bun run typecheck'
  step_timings_run backend-v2-tests sh -c 'cd packages/backend-v2 && bun run test:coverage'
  step_timings_run backend-v2-scripts sh -c 'cd packages/backend-v2 && bun run test:scripts'
fi

if needs terraform && [ -d "$REPO_ROOT/terraform" ]; then
  require_worktree_is_push terraform
  step_timings_run terraform-fmt terraform fmt -check -recursive terraform
  step_timings_run terraform-wrapper bun test ./terraform/
fi

if needs website && [ -d "$REPO_ROOT/packages/website" ]; then
  require_worktree_is_push packages/website assets/brand agent-tool.json
  step_timings_run website-lint sh -c 'cd packages/website && bun run lint'
  step_timings_run website-check sh -c 'cd packages/website && bun run check'
  step_timings_run website-tests sh -c 'cd packages/website && bun run test'
fi

step_timings_summary

echo "All checks passed."

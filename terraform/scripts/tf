#!/bin/bash
# Run Terraform for one stack with its tier's credentials, read from the
# gitignored `.secrets` link at the repository root (`.secrets/<tier>/app.env`)
# into this process's environment only:
#   scripts/tf <zone|staging|production> <terraform arguments...>
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
stack=${1:-}
if [ -z "$stack" ] || [ ! -d "$root/stacks/$stack" ]; then
  stacks=$(for dir in "$root"/stacks/*/; do basename "$dir"; done | paste -sd '|' -)
  echo "Usage: $0 <$stacks> <terraform arguments...>" >&2
  exit 2
fi
shift

# The zone is shared by every environment, so it uses the prod tier.
case "$stack" in
  staging) tier=staging ;;
  production | zone) tier=prod ;;
  *)
    echo "Error: $0 has no secrets tier for the $stack stack" >&2
    exit 2
    ;;
esac
secrets="$(dirname "$root")/.secrets/$tier"

# Only the credentials in the tier's files may reach Terraform: never ones
# inherited from the shell (another account's token, an AWS profile).
unset AWS_PROFILE AWS_SESSION_TOKEN AWS_SHARED_CREDENTIALS_FILE \
  AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY CLOUDFLARE_API_TOKEN \
  CLOUDFLARE_API_KEY CLOUDFLARE_EMAIL CLOUDFLARE_API_USER_SERVICE_KEY \
  TF_STATE_ACCESS_KEY_ID TF_STATE_SECRET_ACCESS_KEY

names='CLOUDFLARE_API_TOKEN TF_STATE_ACCESS_KEY_ID TF_STATE_SECRET_ACCESS_KEY'

# Read the NAME=value lines for these names into unexported shell variables.
# The file is parsed, never sourced, so nothing in it runs, and other names in
# it are ignored.
read_env() {
  local line name
  while IFS= read -r line || [ -n "$line" ]; do
    for name in $names; do
      case "$line" in "$name="*) printf -v "$name" '%s' "${line#*=}" ;; esac
    done
  done <"$1"
}

if [ ! -f "$secrets/app.env" ]; then
  echo "Error: $secrets/app.env not found; the $stack stack reads its credentials from it" >&2
  exit 1
fi
# A tier's shared.env holds account-wide values; its app.env loads after it
# and wins.
if [ -f "$secrets/shared.env" ]; then
  read_env "$secrets/shared.env"
fi
read_env "$secrets/app.env"

missing=0
for name in $names; do
  if [ -z "${!name:-}" ]; then
    echo "Error: $name is missing from $secrets/app.env" >&2
    missing=1
  fi
done
[ "$missing" -eq 0 ] || exit 1

# The S3 backend, pointed at R2, reads the state key as AWS credentials.
export CLOUDFLARE_API_TOKEN
export AWS_ACCESS_KEY_ID="$TF_STATE_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="$TF_STATE_SECRET_ACCESS_KEY"
unset TF_STATE_ACCESS_KEY_ID TF_STATE_SECRET_ACCESS_KEY

exec terraform -chdir="$root/stacks/$stack" "$@"

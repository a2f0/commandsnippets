#!/bin/bash
# Run Terraform for one stack with the SOPS-encrypted credentials, which are
# decrypted into this process's environment only:
#   scripts/tf <zone|staging|production> <terraform arguments...>
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
stack=${1:-}
if [ -z "$stack" ] || [ ! -d "$root/stacks/$stack" ]; then
  stacks=$(for dir in "$root"/stacks/*/; do basename "$dir"; done | paste -sd '|' -)
  echo "Usage: $0 <$stacks> <terraform arguments...>" >&2
  exit 2
fi
shift

# Only the credentials in secrets.env.sops may reach Terraform: never ones
# inherited from the shell (another account's token, an AWS profile).
unset AWS_PROFILE AWS_SESSION_TOKEN AWS_SHARED_CREDENTIALS_FILE \
  AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY CLOUDFLARE_API_TOKEN \
  CLOUDFLARE_API_KEY CLOUDFLARE_EMAIL CLOUDFLARE_API_USER_SERVICE_KEY

if ! secrets=$(sops decrypt --input-type dotenv --output-type dotenv "$root/secrets.env.sops"); then
  echo "Error: could not decrypt $root/secrets.env.sops" >&2
  exit 1
fi
while IFS='=' read -r key value; do
  case "$key" in '' | \#*) continue ;; esac
  export "$key=$value"
done <<<"$secrets"
for name in CLOUDFLARE_API_TOKEN AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
  if [ -z "${!name:-}" ]; then
    echo "Error: $name is missing from secrets.env.sops" >&2
    exit 1
  fi
done

exec terraform -chdir="$root/stacks/$stack" "$@"

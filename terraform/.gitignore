# Terraform
**/.terraform/*
# Only the stacks pin providers; `terraform test` inits the modules.
/modules/*/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Plaintext variable files; secrets live in secrets.env.sops.
*.tfvars

# Plaintext keys decrypted from the removed ssh_keys/*.sops files
/ssh_keys/

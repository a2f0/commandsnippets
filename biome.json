{
  "$schema": "https://biomejs.dev/schemas/1.5.3/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingComma": "es5",
      "bracketSpacing": false,
      "arrowParentheses": "asNeeded"
    }
  },
  "files": {
    "ignore": [
      ".ts-out/**/*",
      "build/",
      "**/*.d.ts",
      "src/ts-out/**/*",
      "dev-dist/",
      "dist/",
      "node_modules/"
    ]
  }
}

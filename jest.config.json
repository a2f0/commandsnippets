{
  "extensionsToTreatAsEsm": [".ts", ".tsx"],
  "setupFiles": ["<rootDir>/__tests__/setup.ts"],
  "testEnvironment": "jsdom",
  "testMatch": ["**/__tests__/**/*.spec.tsx", "**/__tests__/**/*.spec.ts"],
  "testEnvironmentOptions": {
    "url": "http://localhost:8081/"
  },
  "transform": {
    "^.+\\.[tj]sx?$": "@swc/jest"
  }
}

{
  "extends": "@tsconfig/strictest",
  "compilerOptions": {
    "outDir": "./.ts-out",
    "rootDir": ".",
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "checkJs": false,
    "allowJs": false,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "react",
    "incremental": true
  },
  "ts-node": {
    "swc": true
  }
}

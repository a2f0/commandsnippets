{
  "name": "tearleads-frontend",
  "version": "0.7.27",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "=20.17.0"
  },
  "scripts": {
    "server": "vite serve",
    "server-test": "vite serve --port 8081",
    "test": "NODE_OPTIONS='--experimental-specifier-resolution=node --no-warnings' npx wdio test/wdio.shared.conf.ts",
    "test-headless": "NODE_OPTIONS='--experimental-specifier-resolution=node --no-warnings' npx wdio test/wdio.headless.conf.ts",
    "ci": "start-server-and-test server-test http-get://localhost:8081 test",
    "ci-headless": "start-server-and-test server-test http-get://localhost:8081 test-headless",
    "unit": "npx vitest --no-watch",
    "format": "biome format --write \"src/**/*.{js,ts,tsx,json}\"",
    "lint": "biome lint",
    "build": "vite build",
    "postbuild": "scripts/postBuild.sh",
    "clean": "rm -rf dist",
    "compile": "tsc -b",
    "prepare": "npm run compile"
  },
  "keywords": [],
  "author": "Dan Sullivan",

{
  "name": "tearleads-frontend",
  "version": "0.6.5",
  "description": "",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "=18.17.0"
  },
  "scripts": {
    "server": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm'  webpack serve --mode development --history-api-fallback",
    "server-test": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack serve --port 8081 --mode development --history-api-fallback",
    "test": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' TS_NODE_PROJECT=test/tsconfig.json npx wdio test/wdio.shared.conf.ts",
    "test-headless": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' TS_NODE_PROJECT=test/tsconfig.json npx wdio test/wdio.headless.conf.ts",
    "ci": "start-server-and-test server-test http-get://localhost:8081 test",
    "ci-headless": "start-server-and-test server-test http-get://localhost:8081 test-headless",
    "unit": "NODE_OPTIONS=--experimental-vm-modules npx jest",
    "format": "prettier --write \"src/**/*.js\"",
    "eslint-fix": "eslint --fix \"src/**/*.js\"",
    "build": "NODE_OPTIONS='--experimental-specifier-resolution=node --loader ts-node/esm' webpack --mode production",
    "lint": "gts lint",
    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "keywords": [],
  "author": "Dan Sullivan",

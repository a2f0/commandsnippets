{
  "name": "commandsnippets",
  "private": true,
  "type": "module",
  "workspaces": ["packages/agent-tool"],
  "catalog": {
    "@types/bun": "1.4.2"
  },
  "scripts": {
    "hooks:install": "sh scripts/git/install-hooks.sh",
    "lint:branch-name": "bun scripts/checks/lintBranchName.ts",
    "lint:shell": "shellcheck --shell=sh scripts/git/install-hooks.sh scripts/git/showPushGateTimings.sh scripts/git/hooks/commit-msg scripts/git/hooks/pre-push scripts/lib/stepTimings.sh scripts/checks/checkCommitTrust.sh scripts/checks/stripClaudeCoauthors.sh",
    "test:agent-tool": "bun run --cwd packages/agent-tool test",
    "test:scripts": "bun test ./scripts/",
    "typecheck": "tsc -p packages/agent-tool && tsc -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "catalog:",
    "typescript": "7.0.2"
  }
}
